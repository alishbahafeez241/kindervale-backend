{
  "info": {
    "name": "Kindervale Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "lessonPlanId",
      "value": ""
    },
    {
      "key": "classId",
      "value": ""
    },
    {
      "key": "subjectId",
      "value": ""
    },
    {
      "key": "teacherId",
      "value": ""
    },
    {
      "key": "studentId",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "Auth - Profile",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/auth/profile",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "profile"]
        }
      }
    },
    {
      "name": "Lesson Plans - Create",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"teacherId\": \"{{teacherId}}\",\n  \"classId\": \"{{classId}}\",\n  \"subjectId\": \"{{subjectId}}\",\n  \"subject\": \"Mathematics\",\n  \"weekStartDate\": \"2026-08-03\",\n  \"objectives\": \"Introduce number bonds and counting practice.\",\n  \"activities\": \"Warm-up counting, guided worksheet, group exercise.\",\n  \"resources\": \"Counters, worksheet, whiteboard\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/lesson-plans",
          "host": ["{{baseUrl}}"],
          "path": ["lesson-plans"]
        }
      }
    },
    {
      "name": "Lesson Plans - List",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/lesson-plans?page=1&limit=10",
          "host": ["{{baseUrl}}"],
          "path": ["lesson-plans"],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            }
          ]
        }
      }
    },
    {
      "name": "Lesson Plans - Get One",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/lesson-plans/{{lessonPlanId}}",
          "host": ["{{baseUrl}}"],
          "path": ["lesson-plans", "{{lessonPlanId}}"]
        }
      }
    },
    {
      "name": "Lesson Plans - Update",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"objectives\": \"Updated weekly objectives\",\n  \"activities\": \"Updated activities\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/lesson-plans/{{lessonPlanId}}",
          "host": ["{{baseUrl}}"],
          "path": ["lesson-plans", "{{lessonPlanId}}"]
        }
      }
    },
    {
      "name": "Lesson Plans - Submit",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/lesson-plans/{{lessonPlanId}}/submit",
          "host": ["{{baseUrl}}"],
          "path": ["lesson-plans", "{{lessonPlanId}}", "submit"]
        }
      }
    },
    {
      "name": "Lesson Plans - Review",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"APPROVED\",\n  \"reviewRemarks\": \"Approved for this week.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/lesson-plans/{{lessonPlanId}}/review",
          "host": ["{{baseUrl}}"],
          "path": ["lesson-plans", "{{lessonPlanId}}", "review"]
        }
      }
    },
    {
      "name": "Lesson Plans - Delete",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/lesson-plans/{{lessonPlanId}}",
          "host": ["{{baseUrl}}"],
          "path": ["lesson-plans", "{{lessonPlanId}}"]
        }
      }
    },
    {
      "name": "Dashboard",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/dashboard",
          "host": ["{{baseUrl}}"],
          "path": ["dashboard"]
        }
      }
    },
    {
      "name": "Fees - Create",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"invoice\": \"INV-001\",\n  \"studentId\": \"{{studentId}}\",\n  \"amount\": 1500,\n  \"dueDate\": \"2026-08-15\",\n  \"status\": \"PENDING\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/fees",
          "host": ["{{baseUrl}}"],
          "path": ["fees"]
        }
      }
    },
    {
      "name": "Calendar Events - List",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/calendar-events",
          "host": ["{{baseUrl}}"],
          "path": ["calendar-events"]
        }
      }
    },
    {
      "name": "Notifications - List",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/notifications",
          "host": ["{{baseUrl}}"],
          "path": ["notifications"]
        }
      }
    },
    {
      "name": "Settings - Get",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/settings",
          "host": ["{{baseUrl}}"],
          "path": ["settings"]
        }
      }
    }
  ]
}
