{
  "info": {
    "name": "Kindervale Backend API",
    "description": "Postman collection for the Kindervale NestJS backend. Set baseUrl to your backend URL, then run Auth - Login and copy the returned accessToken into the accessToken variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "adminId", "value": "" },
    { "key": "teacherId", "value": "" },
    { "key": "parentId", "value": "" },
    { "key": "studentId", "value": "" },
    { "key": "classId", "value": "" },
    { "key": "sectionId", "value": "" },
    { "key": "subjectId", "value": "" },
    { "key": "attendanceId", "value": "" },
    { "key": "homeworkId", "value": "" },
    { "key": "lessonPlanId", "value": "" },
    { "key": "roleId", "value": "" },
    { "key": "permissionId", "value": "" },
    { "key": "feeId", "value": "" },
    { "key": "examId", "value": "" },
    { "key": "reportCardId", "value": "" },
    { "key": "calendarEventId", "value": "" },
    { "key": "timetableId", "value": "" },
    { "key": "documentId", "value": "" },
    { "key": "leaveRequestId", "value": "" },
    { "key": "expenseId", "value": "" },
    { "key": "faqId", "value": "" },
    { "key": "schoolPolicyId", "value": "" },
    { "key": "daycareReportId", "value": "" },
    { "key": "daycareResourceId", "value": "" },
    { "key": "backupId", "value": "" },
    { "key": "notificationId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        { "name": "Login", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"role\": \"daycareadmin\",\n  \"username\": \"daycareadmin\",\n  \"password\": \"demo123\",\n  \"otp\": \"0000\"\n}" }, "url": "{{baseUrl}}/auth/login" } },
        { "name": "Refresh Token", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" }, "url": "{{baseUrl}}/auth/refresh" } },
        { "name": "Logout", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" }, "url": "{{baseUrl}}/auth/logout" } },
        { "name": "Forgot Password", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@example.com\"\n}" }, "url": "{{baseUrl}}/auth/forgot-password" } },
        { "name": "Reset Password", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@example.com\",\n  \"otp\": \"123456\",\n  \"newPassword\": \"password123\"\n}" }, "url": "{{baseUrl}}/auth/reset-password" } },
        { "name": "Change Password", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"password\",\n  \"newPassword\": \"password123\"\n}" }, "url": "{{baseUrl}}/auth/change-password" } },
        { "name": "Profile", "request": { "method": "GET", "url": "{{baseUrl}}/auth/profile" } }
      ]
    },
    {
      "name": "Core Management",
      "item": [
        { "name": "Create User", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Admin User\",\n  \"email\": \"admin@example.com\",\n  \"password\": \"password\",\n  \"role\": \"ADMIN\"\n}" }, "url": "{{baseUrl}}/users" } },
        { "name": "List Users", "request": { "method": "GET", "url": "{{baseUrl}}/users?page=1&limit=10&sortBy=createdAt&sortOrder=desc" } },
        { "name": "Get User", "request": { "method": "GET", "url": "{{baseUrl}}/users/{{userId}}" } },
        { "name": "Update User", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated User\",\n  \"status\": \"ACTIVE\"\n}" }, "url": "{{baseUrl}}/users/{{userId}}" } },
        { "name": "Delete User", "request": { "method": "DELETE", "url": "{{baseUrl}}/users/{{userId}}" } },
        { "name": "Create Admin", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"phone\": \"+10000000000\",\n  \"designation\": \"Administrator\",\n  \"permissions\": [\"users:read\"]\n}" }, "url": "{{baseUrl}}/admins" } },
        { "name": "List Admins", "request": { "method": "GET", "url": "{{baseUrl}}/admins" } },
        { "name": "Get Admin", "request": { "method": "GET", "url": "{{baseUrl}}/admins/{{adminId}}" } },
        { "name": "Update Admin", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"designation\": \"Principal\"\n}" }, "url": "{{baseUrl}}/admins/{{adminId}}" } },
        { "name": "Delete Admin", "request": { "method": "DELETE", "url": "{{baseUrl}}/admins/{{adminId}}" } }
      ]
    },
    {
      "name": "People",
      "item": [
        { "name": "Create Teacher", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"phone\": \"+10000000001\",\n  \"subject\": \"Mathematics\",\n  \"className\": \"KG-1\",\n  \"attendance\": \"PRESENT\"\n}" }, "url": "{{baseUrl}}/teachers" } },
        { "name": "List Teachers", "request": { "method": "GET", "url": "{{baseUrl}}/teachers?page=1&limit=10&sortBy=createdAt&sortOrder=desc" } },
        { "name": "Get Teacher", "request": { "method": "GET", "url": "{{baseUrl}}/teachers/{{teacherId}}" } },
        { "name": "Update Teacher", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"subject\": \"English\",\n  \"attendance\": \"PRESENT\"\n}" }, "url": "{{baseUrl}}/teachers/{{teacherId}}" } },
        { "name": "Delete Teacher", "request": { "method": "DELETE", "url": "{{baseUrl}}/teachers/{{teacherId}}" } },
        { "name": "Create Parent", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Parent User\",\n  \"email\": \"parent@example.com\",\n  \"phone\": \"+10000000002\"\n}" }, "url": "{{baseUrl}}/parents" } },
        { "name": "List Parents", "request": { "method": "GET", "url": "{{baseUrl}}/parents?page=1&limit=10&sortBy=createdAt&sortOrder=desc" } },
        { "name": "Get Parent", "request": { "method": "GET", "url": "{{baseUrl}}/parents/{{parentId}}" } },
        { "name": "Get Parent Students", "request": { "method": "GET", "url": "{{baseUrl}}/parents/{{parentId}}/students" } },
        { "name": "Update Parent", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"phone\": \"+10000000003\"\n}" }, "url": "{{baseUrl}}/parents/{{parentId}}" } },
        { "name": "Delete Parent", "request": { "method": "DELETE", "url": "{{baseUrl}}/parents/{{parentId}}" } },
        { "name": "Create Student", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"admissionNo\": \"ADM-001\",\n  \"parentId\": \"{{parentId}}\",\n  \"name\": \"Student User\",\n  \"className\": \"KG-1\",\n  \"age\": 5,\n  \"birthday\": \"2021-08-01\",\n  \"attendance\": 95,\n  \"phone\": \"+10000000004\",\n  \"feeStatus\": \"PENDING\"\n}" }, "url": "{{baseUrl}}/students" } },
        { "name": "List Students", "request": { "method": "GET", "url": "{{baseUrl}}/students?page=1&limit=10&sortBy=createdAt&sortOrder=desc" } },
        { "name": "Get Student", "request": { "method": "GET", "url": "{{baseUrl}}/students/{{studentId}}" } },
        { "name": "Update Student", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"attendance\": 98,\n  \"feeStatus\": \"PAID\"\n}" }, "url": "{{baseUrl}}/students/{{studentId}}" } },
        { "name": "Delete Student", "request": { "method": "DELETE", "url": "{{baseUrl}}/students/{{studentId}}" } }
      ]
    },
    {
      "name": "Academics",
      "item": [
        { "name": "Create Class", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"KG-1\",\n  \"teacher\": \"Ms. Smith\",\n  \"homeroomTeacherId\": \"{{teacherId}}\",\n  \"academicYear\": \"2026-2027\",\n  \"capacity\": 30\n}" }, "url": "{{baseUrl}}/classes" } },
        { "name": "List Classes", "request": { "method": "GET", "url": "{{baseUrl}}/classes?page=1&limit=10&sortBy=createdAt&sortOrder=desc" } },
        { "name": "Get Class", "request": { "method": "GET", "url": "{{baseUrl}}/classes/{{classId}}" } },
        { "name": "Update Class", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"capacity\": 35\n}" }, "url": "{{baseUrl}}/classes/{{classId}}" } },
        { "name": "Delete Class", "request": { "method": "DELETE", "url": "{{baseUrl}}/classes/{{classId}}" } },
        { "name": "Create Section", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"classId\": \"{{classId}}\",\n  \"name\": \"A\",\n  \"capacity\": 20\n}" }, "url": "{{baseUrl}}/sections" } },
        { "name": "List Sections", "request": { "method": "GET", "url": "{{baseUrl}}/sections?classId={{classId}}" } },
        { "name": "Get Section", "request": { "method": "GET", "url": "{{baseUrl}}/sections/{{sectionId}}" } },
        { "name": "Update Section", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"capacity\": 25\n}" }, "url": "{{baseUrl}}/sections/{{sectionId}}" } },
        { "name": "Delete Section", "request": { "method": "DELETE", "url": "{{baseUrl}}/sections/{{sectionId}}" } },
        { "name": "Create Subject", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Mathematics\",\n  \"code\": \"MATH-101\",\n  \"description\": \"Basic mathematics\",\n  \"classId\": \"{{classId}}\",\n  \"teacherId\": \"{{teacherId}}\"\n}" }, "url": "{{baseUrl}}/subjects" } },
        { "name": "List Subjects", "request": { "method": "GET", "url": "{{baseUrl}}/subjects?page=1&limit=10&sortBy=createdAt&sortOrder=desc" } },
        { "name": "Get Subject", "request": { "method": "GET", "url": "{{baseUrl}}/subjects/{{subjectId}}" } },
        { "name": "Update Subject", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"description\": \"Updated subject description\"\n}" }, "url": "{{baseUrl}}/subjects/{{subjectId}}" } },
        { "name": "Delete Subject", "request": { "method": "DELETE", "url": "{{baseUrl}}/subjects/{{subjectId}}" } }
      ]
    },
    {
      "name": "Attendance, Homework, Lesson Plans",
      "item": [
        { "name": "Create Attendance", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"studentId\": \"{{studentId}}\",\n  \"classId\": \"{{classId}}\",\n  \"date\": \"2026-08-01\",\n  \"status\": \"PRESENT\",\n  \"remarks\": \"On time\"\n}" }, "url": "{{baseUrl}}/attendance" } },
        { "name": "Bulk Attendance", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"classId\": \"{{classId}}\",\n  \"date\": \"2026-08-01\",\n  \"records\": [\n    { \"studentId\": \"{{studentId}}\", \"status\": \"PRESENT\", \"remarks\": \"On time\" }\n  ]\n}" }, "url": "{{baseUrl}}/attendance/bulk" } },
        { "name": "List Attendance", "request": { "method": "GET", "url": "{{baseUrl}}/attendance?page=1&limit=10&sortBy=date&sortOrder=desc" } },
        { "name": "Get Attendance", "request": { "method": "GET", "url": "{{baseUrl}}/attendance/{{attendanceId}}" } },
        { "name": "Update Attendance", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"ABSENT\",\n  \"remarks\": \"Sick leave\"\n}" }, "url": "{{baseUrl}}/attendance/{{attendanceId}}" } },
        { "name": "Delete Attendance", "request": { "method": "DELETE", "url": "{{baseUrl}}/attendance/{{attendanceId}}" } },
        { "name": "Create Homework", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Counting Practice\",\n  \"description\": \"Complete worksheet 1\",\n  \"classId\": \"{{classId}}\",\n  \"subjectId\": \"{{subjectId}}\",\n  \"teacherId\": \"{{teacherId}}\",\n  \"className\": \"KG-1\",\n  \"subject\": \"Mathematics\",\n  \"dueDate\": \"2026-08-10\"\n}" }, "url": "{{baseUrl}}/homework" } },
        { "name": "List Homework", "request": { "method": "GET", "url": "{{baseUrl}}/homework?page=1&limit=10&sortBy=dueDate&sortOrder=asc" } },
        { "name": "Get Homework", "request": { "method": "GET", "url": "{{baseUrl}}/homework/{{homeworkId}}" } },
        { "name": "Update Homework", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"description\": \"Updated homework\"\n}" }, "url": "{{baseUrl}}/homework/{{homeworkId}}" } },
        { "name": "Delete Homework", "request": { "method": "DELETE", "url": "{{baseUrl}}/homework/{{homeworkId}}" } },
        { "name": "Create Lesson Plan", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"teacherId\": \"{{teacherId}}\",\n  \"classId\": \"{{classId}}\",\n  \"subjectId\": \"{{subjectId}}\",\n  \"subject\": \"Mathematics\",\n  \"weekStartDate\": \"2026-08-03\",\n  \"objectives\": \"Introduce counting\",\n  \"activities\": \"Worksheet and group activity\",\n  \"resources\": \"Counters and whiteboard\"\n}" }, "url": "{{baseUrl}}/lesson-plans" } },
        { "name": "List Lesson Plans", "request": { "method": "GET", "url": "{{baseUrl}}/lesson-plans?page=1&limit=10&sortBy=createdAt&sortOrder=desc" } },
        { "name": "Get Lesson Plan", "request": { "method": "GET", "url": "{{baseUrl}}/lesson-plans/{{lessonPlanId}}" } },
        { "name": "Update Lesson Plan", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"objectives\": \"Updated objectives\"\n}" }, "url": "{{baseUrl}}/lesson-plans/{{lessonPlanId}}" } },
        { "name": "Submit Lesson Plan", "request": { "method": "POST", "url": "{{baseUrl}}/lesson-plans/{{lessonPlanId}}/submit" } },
        { "name": "Review Lesson Plan", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"APPROVED\",\n  \"reviewRemarks\": \"Approved\"\n}" }, "url": "{{baseUrl}}/lesson-plans/{{lessonPlanId}}/review" } },
        { "name": "Delete Lesson Plan", "request": { "method": "DELETE", "url": "{{baseUrl}}/lesson-plans/{{lessonPlanId}}" } }
      ]
    },
    {
      "name": "Roles and Permissions",
      "item": [
        { "name": "Create Role", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"ADMIN\",\n  \"description\": \"Administrator role\"\n}" }, "url": "{{baseUrl}}/roles" } },
        { "name": "List Roles", "request": { "method": "GET", "url": "{{baseUrl}}/roles" } },
        { "name": "Get Role", "request": { "method": "GET", "url": "{{baseUrl}}/roles/{{roleId}}" } },
        { "name": "Update Role", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"description\": \"Updated role\"\n}" }, "url": "{{baseUrl}}/roles/{{roleId}}" } },
        { "name": "Delete Role", "request": { "method": "DELETE", "url": "{{baseUrl}}/roles/{{roleId}}" } },
        { "name": "Create Permission", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"module\": \"users\",\n  \"action\": \"read\",\n  \"description\": \"Read users\"\n}" }, "url": "{{baseUrl}}/permissions" } },
        { "name": "List Permissions", "request": { "method": "GET", "url": "{{baseUrl}}/permissions" } },
        { "name": "Get Permission", "request": { "method": "GET", "url": "{{baseUrl}}/permissions/{{permissionId}}" } },
        { "name": "Update Permission", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"description\": \"Updated permission\"\n}" }, "url": "{{baseUrl}}/permissions/{{permissionId}}" } },
        { "name": "Delete Permission", "request": { "method": "DELETE", "url": "{{baseUrl}}/permissions/{{permissionId}}" } },
        { "name": "Assign Role Permissions", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"permissionIds\": [\"{{permissionId}}\"]\n}" }, "url": "{{baseUrl}}/roles/{{roleId}}/permissions" } },
        { "name": "Get Role Permissions", "request": { "method": "GET", "url": "{{baseUrl}}/roles/{{roleId}}/permissions" } },
        { "name": "Seed Default Roles", "request": { "method": "POST", "url": "{{baseUrl}}/roles/seed-defaults" } }
      ]
    },
    {
      "name": "School Operations",
      "item": [
        { "name": "Dashboard", "request": { "method": "GET", "url": "{{baseUrl}}/dashboard" } },
        { "name": "Create Fee", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"invoice\": \"INV-001\",\n  \"studentId\": \"{{studentId}}\",\n  \"amount\": 1500,\n  \"dueDate\": \"2026-08-15\",\n  \"status\": \"PENDING\"\n}" }, "url": "{{baseUrl}}/fees" } },
        { "name": "List Fees", "request": { "method": "GET", "url": "{{baseUrl}}/fees" } },
        { "name": "Get Fee", "request": { "method": "GET", "url": "{{baseUrl}}/fees/{{feeId}}" } },
        { "name": "Update Fee", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"PAID\"\n}" }, "url": "{{baseUrl}}/fees/{{feeId}}" } },
        { "name": "Delete Fee", "request": { "method": "DELETE", "url": "{{baseUrl}}/fees/{{feeId}}" } },
        { "name": "Create Exam", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Midterm Exam\",\n  \"subject\": \"Mathematics\",\n  \"className\": \"KG-1\",\n  \"date\": \"2026-09-01\",\n  \"maxMarks\": 100\n}" }, "url": "{{baseUrl}}/exams" } },
        { "name": "List Exams", "request": { "method": "GET", "url": "{{baseUrl}}/exams" } },
        { "name": "Get Exam", "request": { "method": "GET", "url": "{{baseUrl}}/exams/{{examId}}" } },
        { "name": "Update Exam", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"maxMarks\": 50\n}" }, "url": "{{baseUrl}}/exams/{{examId}}" } },
        { "name": "Delete Exam", "request": { "method": "DELETE", "url": "{{baseUrl}}/exams/{{examId}}" } },
        { "name": "Create Report Card", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"studentId\": \"{{studentId}}\",\n  \"term\": \"Term 1\",\n  \"className\": \"KG-1\",\n  \"academicYear\": \"2026-2027\",\n  \"summary\": \"Good progress\"\n}" }, "url": "{{baseUrl}}/report-cards" } },
        { "name": "List Report Cards", "request": { "method": "GET", "url": "{{baseUrl}}/report-cards" } },
        { "name": "Get Report Card", "request": { "method": "GET", "url": "{{baseUrl}}/report-cards/{{reportCardId}}" } },
        { "name": "Update Report Card", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"summary\": \"Updated summary\"\n}" }, "url": "{{baseUrl}}/report-cards/{{reportCardId}}" } },
        { "name": "Publish Report Card", "request": { "method": "POST", "url": "{{baseUrl}}/report-cards/{{reportCardId}}/publish" } },
        { "name": "Delete Report Card", "request": { "method": "DELETE", "url": "{{baseUrl}}/report-cards/{{reportCardId}}" } }
      ]
    },
    {
      "name": "Resources and Communication",
      "item": [
        { "name": "Create Calendar Event", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Parents Meeting\",\n  \"date\": \"2026-08-20\",\n  \"type\": \"meeting\"\n}" }, "url": "{{baseUrl}}/calendar-events" } },
        { "name": "List Calendar Events", "request": { "method": "GET", "url": "{{baseUrl}}/calendar-events" } },
        { "name": "Get Calendar Event", "request": { "method": "GET", "url": "{{baseUrl}}/calendar-events/{{calendarEventId}}" } },
