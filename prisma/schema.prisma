generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  DAYCAREADMIN
  PRINCIPAL
  TEACHER
  PARENT

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  INACTIVE

  @@map("user_status")
}

enum TeacherAttendance {
  PRESENT
  LATE
  ABSENT

  @@map("teacher_attendance")
}

enum FeeStatus {
  PAID
  PENDING
  PARTIAL

  @@map("fee_status")
}

enum NotificationAudience {
  ALL
  ADMIN
  PRINCIPAL
  TEACHER
  PARENT
  STUDENT

  @@map("notification_audience")
}

enum StudentAttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED

  @@map("student_attendance_status")
}

enum LessonPlanStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED

  @@map("lesson_plan_status")
}

enum ReviewStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED

  @@map("review_status")
}

enum DocumentType {
  DOCUMENT
  PHOTO
  REPORT_CARD
  POLICY

  @@map("document_type")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@map("leave_status")
}

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  MANAGE

  @@map("permission_action")
}

model User {
  id                  String               @id
  name                String
  email               String               @unique
  password            String
  role                UserRole
  status              UserStatus           @default(ACTIVE)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @default(now()) @map("updated_at")
  admin               Admin?
  teacher             Teacher?
  parent              Parent?
  student             Student?
  homeroomClasses     Class[]              @relation("ClassHomeroomTeacher")
  subjects            Subject[]            @relation("SubjectTeacher")
  markedAttendance    Attendance[]         @relation("AttendanceMarkedBy")
  createdReportCards  ReportCard[]         @relation("ReportCardCreatedBy")
  homework            Homework[]           @relation("HomeworkTeacher")
  lessonPlans         LessonPlan[]         @relation("LessonPlanTeacher")
  reviewedLessonPlans LessonPlan[]         @relation("LessonPlanReviewedBy")
  timetables          Timetable[]          @relation("TimetableTeacher")
  uploadedDocuments   Document[]           @relation("DocumentUploadedBy")
  leaveRequests       LeaveRequest[]       @relation("LeaveRequestUser")
  reviewedLeaves      LeaveRequest[]       @relation("LeaveRequestReviewedBy")
  expenses            Expense[]            @relation("ExpenseCreatedBy")
  daycareReports      DaycareReport[]      @relation("DaycareReportCreatedBy")
  daycareResources    DaycareResource[]    @relation("DaycareResourceCreatedBy")
  backups             Backup[]             @relation("BackupRequestedBy")
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model Admin {
  id          String   @id
  userId      String   @unique @map("user_id")
  phone       String?
  designation String   @default("Admin")
  permissions Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admins")
}

model Teacher {
  id         String            @id
  userId     String            @unique @map("user_id")
  phone      String?
  subject    String
  className  String            @map("class_name")
  attendance TeacherAttendance @default(PRESENT)
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @default(now()) @map("updated_at")
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("teachers")
}

model Role {
  id              String           @id
  name            UserRole          @unique
  description     String?
  isSystem        Boolean          @default(true) @map("is_system")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @default(now()) @map("updated_at")
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              String           @id
  module          String
  action          PermissionAction
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @default(now()) @map("updated_at")
  rolePermissions RolePermission[]

  @@unique([module, action], map: "permissions_module_action_unique")
  @@index([module], map: "permissions_module_idx")
  @@map("permissions")
}

model RolePermission {
  id           String     @id
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @default(now()) @map("updated_at")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId], map: "role_permissions_role_permission_unique")
  @@map("role_permissions")
}

model Parent {
  id        String    @id
  userId    String?   @unique @map("user_id")
  name      String
  email     String    @unique
  phone     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @map("updated_at")
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  students  Student[]

  @@map("parents")
}

model Student {
  id             String          @id
  admissionNo    String          @unique @map("admission_no")
  userId         String?         @unique @map("user_id")
  parentId       String?         @map("parent_id")
  name           String
  className      String          @map("class_name")
  age            Int
  birthday       DateTime        @db.Date
  attendance     Int             @default(0)
  phone          String?
  feeStatus      FeeStatus       @default(PENDING) @map("fee_status")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @default(now()) @map("updated_at")
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  parent         Parent?         @relation(fields: [parentId], references: [id], onDelete: SetNull)
  attendances    Attendance[]
  fees           Fee[]
  reportCards    ReportCard[]
  documents      Document[]
  daycareReports DaycareReport[]

  @@map("students")
}

model Class {
  id                String       @id
  name              String       @unique
  teacher           String
  homeroomTeacherId String?      @map("homeroom_teacher_id")
  academicYear      String?      @map("academic_year")
  capacity          Int
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @default(now()) @map("updated_at")
  homeroomTeacher   User?        @relation("ClassHomeroomTeacher", fields: [homeroomTeacherId], references: [id], onDelete: SetNull)
  sections          Section[]
  subjects          Subject[]
  attendances       Attendance[]
  homework          Homework[]
  lessonPlans       LessonPlan[]
  timetables        Timetable[]

  @@map("classes")
}

model Section {
  id        String   @id
  classId   String   @map("class_id")
  name      String
  capacity  Int?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@map("sections")
}

model Subject {
  id          String     @id
  name        String     @unique
  code        String?    @unique
  description String?
  classId     String?    @map("class_id")
  teacherId   String?    @map("teacher_id")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @default(now()) @map("updated_at")
  class       Class?     @relation(fields: [classId], references: [id], onDelete: SetNull)
  teacherUser User?      @relation("SubjectTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  homework    Homework[]
  lessonPlans LessonPlan[]

  @@map("subjects")
}

model Attendance {
  id        String                  @id
  studentId String                  @map("student_id")
  classId   String?                 @map("class_id")
  date      DateTime                @db.Date
  status    StudentAttendanceStatus
  remarks   String?
  markedBy  String?                 @map("marked_by")
  createdAt DateTime                @default(now()) @map("created_at")
  updatedAt DateTime                @default(now()) @map("updated_at")
  student   Student                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class     Class?                  @relation(fields: [classId], references: [id], onDelete: SetNull)
  marker    User?                   @relation("AttendanceMarkedBy", fields: [markedBy], references: [id], onDelete: SetNull)

  @@map("attendance")
}

model Fee {
  id        String    @id
  invoice   String    @unique
  studentId String    @map("student_id")
  amount    Decimal   @db.Decimal(10, 2)
  dueDate   DateTime  @map("due_date") @db.Date
  status    FeeStatus @default(PENDING)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @map("updated_at")
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("fees")
}

model Exam {
  id        String   @id
  title     String
  subject   String
  className String   @map("class_name")
  date      DateTime @db.Date
  maxMarks  Int      @map("max_marks")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("exams")
}

model ReportCard {
  id           String       @id
  studentId    String       @map("student_id")
  term         String
  className    String       @map("class_name")
  academicYear String       @map("academic_year")
  summary      String?
  fileUrl      String?      @map("file_url")
  status       ReviewStatus @default(DRAFT)
  publishedAt  DateTime?    @map("published_at")
  createdBy    String?      @map("created_by")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @default(now()) @map("updated_at")
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  creator      User?        @relation("ReportCardCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@map("report_cards")
}

model Homework {
  id          String   @id
  title       String
  description String?
  classId     String?  @map("class_id")
  subjectId   String?  @map("subject_id")
  teacherId   String?  @map("teacher_id")
  className   String   @map("class_name")
  subject     String
  dueDate     DateTime @map("due_date") @db.Date
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")
  class       Class?   @relation(fields: [classId], references: [id], onDelete: SetNull)
  subjectRow  Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teacherUser User?    @relation("HomeworkTeacher", fields: [teacherId], references: [id], onDelete: SetNull)

  @@map("homework")
}

model LessonPlan {
  id            String           @id
  teacherId     String           @map("teacher_id")
  classId       String           @map("class_id")
  subjectId     String?          @map("subject_id")
  subject       String
  weekStartDate DateTime         @map("week_start_date") @db.Date
  objectives    String
  activities    String
  resources     String?
  status        LessonPlanStatus @default(DRAFT)
  reviewRemarks String?          @map("review_remarks")
  reviewedBy    String?          @map("reviewed_by")
  reviewedAt    DateTime?        @map("reviewed_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @default(now()) @map("updated_at")
  teacher       User             @relation("LessonPlanTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  class         Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectRow    Subject?         @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  reviewer      User?            @relation("LessonPlanReviewedBy", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@map("lesson_plans")
}

model CalendarEvent {
  id        String   @id
  title     String
  date      DateTime @db.Date
  type      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("calendar_events")
}

model Timetable {
  id        String   @id
  classId   String?  @map("class_id")
  className String   @map("class_name")
  dayOfWeek String   @map("day_of_week")
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  subject   String
  teacherId String?  @map("teacher_id")
  room      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  class     Class?   @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher   User?    @relation("TimetableTeacher", fields: [teacherId], references: [id], onDelete: SetNull)

  @@map("timetables")
}

model Document {
  id          String               @id
  title       String
  description String?
  type        DocumentType         @default(DOCUMENT)
  fileUrl     String               @map("file_url")
  audience    NotificationAudience @default(ALL)
  studentId   String?              @map("student_id")
  uploadedBy  String?              @map("uploaded_by")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @default(now()) @map("updated_at")
  student     Student?             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  uploader    User?                @relation("DocumentUploadedBy", fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@map("documents")
}

model LeaveRequest {
  id            String      @id
  userId        String      @map("user_id")
  fromDate      DateTime    @map("from_date") @db.Date
  toDate        DateTime    @map("to_date") @db.Date
  reason        String
  status        LeaveStatus @default(PENDING)
  reviewRemarks String?     @map("review_remarks")
  reviewedBy    String?     @map("reviewed_by")
  reviewedAt    DateTime?   @map("reviewed_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @default(now()) @map("updated_at")
  user          User        @relation("LeaveRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewer      User?       @relation("LeaveRequestReviewedBy", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@map("leave_requests")
}

model Expense {
  id        String   @id
  title     String
  category  String
  amount    Decimal  @db.Decimal(10, 2)
  date      DateTime @db.Date
  notes     String?
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  creator   User?    @relation("ExpenseCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@map("expenses")
}

model Faq {
  id        String               @id
  question  String
  answer    String
  audience  NotificationAudience @default(ALL)
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @default(now()) @map("updated_at")

  @@map("faqs")
}

model SchoolPolicy {
  id          String               @id
  title       String
  content     String
  fileUrl     String?              @map("file_url")
  audience    NotificationAudience @default(ALL)
  publishedAt DateTime?            @map("published_at")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @default(now()) @map("updated_at")

  @@map("school_policies")
}

model DaycareReport {
  id        String   @id
  studentId String   @map("student_id")
  date      DateTime @db.Date
  meals     String?
  nap       String?
  activities String?
  notes     String?
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  creator   User?    @relation("DaycareReportCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@map("daycare_reports")
}

model DaycareResource {
  id          String   @id
  title       String
  description String?
  fileUrl     String?  @map("file_url")
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")
  creator     User?    @relation("DaycareResourceCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@map("daycare_resources")
}

model Backup {
  id          String   @id
  type        String
  status      String   @default("REQUESTED")
  fileUrl     String?  @map("file_url")
  requestedBy String?  @map("requested_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")
  requester   User?    @relation("BackupRequestedBy", fields: [requestedBy], references: [id], onDelete: SetNull)

  @@map("backups")
}

model Notification {
  id        String               @id
  title     String
  body      String
  date      DateTime             @db.Date
  audience  NotificationAudience @default(ALL)
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @default(now()) @map("updated_at")

  @@map("notifications")
}

model Settings {
  id           String   @id
  schoolName   String   @map("school_name")
  academicYear String   @map("academic_year")
  timezone     String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @map("updated_at")

  @@map("settings")
}

model RefreshToken {
  id        String    @id
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id
  userId    String    @map("user_id")
  otpHash   String    @map("otp_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}
