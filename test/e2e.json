{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/../src/$1",
    "^common/(.*)$": "<rootDir>/../src/common/$1",
    "^middleware/(.*)$": "<rootDir>/../src/middleware/$1",
    "^models/(.*)$": "<rootDir>/../src/models/$1",
    "^modules/(.*)$": "<rootDir>/../src/modules/$1",
    "^types/(.*)$": "<rootDir>/../src/types/$1"
  }
}
